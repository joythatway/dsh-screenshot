{
  "name": "@joythatway/dsh-screenshot",
  "version": "0.5.4",
  "description": "Composer toolbar screenshot for DeepSeek Harness: region / window / whole screen, attached into the draft or saved to disk, with a settings page. · 输入框工具栏截图：框选、窗口、整屏，可入草稿或存到桌面，带设置页。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "capture/*.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "joythatway",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "capture",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joythatway/dsh-screenshot.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/joythatway/dsh-screenshot#readme",
  "bugs": {
    "url": "https://github.com/joythatway/dsh-screenshot/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
